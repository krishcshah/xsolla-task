# Required: bearer token that authenticates every /v1/* request.
API_BEARER_TOKEN=change-me-to-a-long-random-secret

# Required for the "llm" provider (Google Gemini). The mock provider works without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: HTTP listen port (default 8080).
PORT=8080
